# Copy to .env for local development (npm run dev reads it). Every variable is optional.

PORT=3000
HOST=0.0.0.0

# Sites whose pages may connect: comma-separated origins, no path, no wildcard.
# Native apps are always accepted.
CORS_ORIGIN=https://derbaliadem.github.io,http://localhost:8081,http://localhost:5173,http://127.0.0.1:5173

# Where the client's address comes from, for per-address limits:
#   empty   = unknown: no per-address limits (safe default behind an unknown proxy)
#   remote  = the TCP peer; only without a proxy in front
#   <name>  = a header that your proxy always overwrites, e.g. cf-connecting-ip
CLIENT_IP_HEADER=

# debug | info | warn | error | silent
LOG_LEVEL=info

MAX_ROOMS=5000
MAX_PLAYERS_PER_ROOM=20
MAX_CONNECTIONS=5000
MAX_CONNECTIONS_PER_IP=100
