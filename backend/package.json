{
  "name": "pulp-agents-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Authoritative Socket.IO server for the pulp word-guessing game. Contract: ../docs/PROTOCOL.md",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "load": "tsx scripts/load.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "express": "4.22.3",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "4.17.25",
    "@types/node": "22.20.7",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
